<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Panda Arm Macro with sensors and ros2_control integration -->
  <xacro:macro name="panda_arm" params="arm_id parent is_ignition:=false *origin">

    <!-- Link 0 - Base -->
    <link name="${arm_id}_link0">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link0.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link0.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Base Joint connecting to parent -->
    <joint name="${arm_id}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${arm_id}_link0"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Link 1 -->
    <link name="${arm_id}_link1">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link1.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link1.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 1 -->
    <joint name="${arm_id}_joint1" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
      <origin rpy="0 0 0" xyz="0 0 0.333"/>
      <parent link="${arm_id}_link0"/>
      <child link="${arm_id}_link1"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
    </joint>

    <!-- Link 2 -->
    <link name="${arm_id}_link2">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link2.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link2.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 2 -->
    <joint name="${arm_id}_joint2" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-1.7628" soft_upper_limit="1.7628"/>
      <origin rpy="-1.57079632679 0 0" xyz="0 0 0"/>
      <parent link="${arm_id}_link1"/>
      <child link="${arm_id}_link2"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-1.8326" upper="1.8326" velocity="10.0"/>
    </joint>

    <!-- Link 3 -->
    <link name="${arm_id}_link3">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link3.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link3.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 3 -->
    <joint name="${arm_id}_joint3" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
      <origin rpy="1.57079632679 0 0" xyz="0 -0.316 0"/>
      <parent link="${arm_id}_link2"/>
      <child link="${arm_id}_link3"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
    </joint>

    <!-- Link 4 -->
    <link name="${arm_id}_link4">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link4.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link4.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 4 -->
    <joint name="${arm_id}_joint4" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-3.0718" soft_upper_limit="-0.0698"/>
      <origin rpy="1.57079632679 0 0" xyz="0.0825 0 0"/>
      <parent link="${arm_id}_link3"/>
      <child link="${arm_id}_link4"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-3.1416" upper="0.0" velocity="10.0"/>
    </joint>

    <!-- Link 5 -->
    <link name="${arm_id}_link5">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link5.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link5.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 5 -->
    <joint name="${arm_id}_joint5" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
      <origin rpy="-1.57079632679 0 0" xyz="-0.0825 0.384 0"/>
      <parent link="${arm_id}_link4"/>
      <child link="${arm_id}_link5"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
    </joint>

    <!-- Link 6 -->
    <link name="${arm_id}_link6">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link6.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link6.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 6 -->
    <joint name="${arm_id}_joint6" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-0.0175" soft_upper_limit="3.7525"/>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <parent link="${arm_id}_link5"/>
      <child link="${arm_id}_link6"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-0.0873" upper="3.8223" velocity="10.0"/>
    </joint>

    <!-- Link 7 -->
    <link name="${arm_id}_link7">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/link7.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/link7.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Joint 7 -->
    <joint name="${arm_id}_joint7" type="revolute">
      <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
      <origin rpy="1.57079632679 0 0" xyz="0.088 0 0"/>
      <parent link="${arm_id}_link6"/>
      <child link="${arm_id}_link7"/>
      <axis xyz="0 0 1"/>
      <limit effort="30.0" lower="-2.9671" upper="2.9671" velocity="10.0"/>
    </joint>

    <!-- Hand Link -->
    <link name="${arm_id}_hand">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/hand.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/hand.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Hand Joint -->
    <joint name="${arm_id}_hand_joint" type="fixed">
      <parent link="${arm_id}_link7"/>
      <child link="${arm_id}_hand"/>
      <origin rpy="0 0 -0.785398163397" xyz="0 0 0.106"/>
    </joint>

    <!-- Left Finger Link -->
    <link name="${arm_id}_leftfinger">
      <visual>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/finger.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/finger.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Right Finger Link -->
    <link name="${arm_id}_rightfinger">
      <visual>
        <origin rpy="0 0 3.14159265359" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://panda_description/meshes/visual/finger.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 3.14159265359" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://panda_description/meshes/collision/finger.obj"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Finger Joint 1 -->
    <joint name="${arm_id}_finger_joint1" type="prismatic">
      <parent link="${arm_id}_hand"/>
      <child link="${arm_id}_leftfinger"/>
      <origin rpy="0 0 0" xyz="0 0 0.0584"/>
      <axis xyz="0 1 0"/>
      <limit effort="30.0" lower="0.0" upper="0.04" velocity="10.0"/>
    </joint>

    <!-- Finger Joint 2 -->
    <joint name="${arm_id}_finger_joint2" type="prismatic">
      <parent link="${arm_id}_hand"/>
      <child link="${arm_id}_rightfinger"/>
      <origin rpy="0 0 0" xyz="0 0 0.0584"/>
      <axis xyz="0 -1 0"/>
      <limit effort="30.0" lower="0.0" upper="0.04" velocity="10.0"/>
    </joint>

  </xacro:macro>

</robot>