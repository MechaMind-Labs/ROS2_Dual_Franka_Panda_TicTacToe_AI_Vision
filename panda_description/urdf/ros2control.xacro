<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This file defines the *single* <ros2_control> block for the 
    ENTIRE multi-robot system. It is included by dual_panda.xacro.
    
    It contains the hardware plugin (loaded once) and the hardcoded
    joint interfaces for BOTH panda_1 and panda_2.
  -->

  <ros2_control name="RobotSystem" type="system">
      
    <!-- ros2_control Gazebo Plugin - loaded ONCE -->
    <hardware>
      <!-- ROS 2 Humble -->
      <!-- We use $(arg is_ignition) because this value is passed down
           from the top-level dual_panda.xacro launch file -->
      <xacro:if value="$(arg is_ignition)">
        <plugin>ign_ros2_control/IgnitionSystem</plugin>
      </xacro:if>
      
      <!-- ROS 2 Iron or above -->
      <xacro:unless value="$(arg is_ignition)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:unless>
    </hardware>

    <!-- === Joints for Panda 1 === -->

    <!-- Joint 1 -->
    <joint name="panda_1_joint1">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 2 -->
    <joint name="panda_1_joint2">
      <command_interface name="position">
        <param name="min">-1.8326</param>
        <param name="max">1.8326</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 3 -->
    <joint name="panda_1_joint3">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 4 -->
    <joint name="panda_1_joint4">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 5 -->
    <joint name="panda_1_joint5">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 6 -->
    <joint name="panda_1_joint6">
      <command_interface name="position">
        <param name="min">-0.0873</param>
        <param name="max">3.8223</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 7 -->
    <joint name="panda_1_joint7">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Gripper Finger Joint 1 -->
    <joint name="panda_1_finger_joint1">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.04</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Gripper Finger Joint 2 (Mimics Joint 1) -->
    <joint name="panda_1_finger_joint2">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.04</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- === Joints for Panda 2 === -->

    <!-- Joint 1 -->
    <joint name="panda_2_joint1">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 2 -->
    <joint name="panda_2_joint2">
      <command_interface name="position">
        <param name="min">-1.8326</param>
        <param name="max">1.8326</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 3 -->
    <joint name="panda_2_joint3">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 4 -->
    <joint name="panda_2_joint4">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 5 -->
    <joint name="panda_2_joint5">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 6 -->
    <joint name="panda_2_joint6">
      <command_interface name="position">
        <param name="min">-0.0873</param>
        <param name="max">3.8223</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Joint 7 -->
    <joint name="panda_2_joint7">
      <command_interface name="position">
        <param name="min">-2.9671</param>
        <param name="max">2.9671</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Gripper Finger Joint 1 -->
    <joint name="panda_2_finger_joint1">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.04</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- Gripper Finger Joint 2 (Mimics Joint 1) -->
    <joint name="panda_2_finger_joint2">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.04</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

  </ros2_control>

</robot>
